import java.io.*;

public class Solution {

    static long stringSimilarity(String s) {
        int n = s.length();
        int[] z = new int[n];

        int left = 0;
        int right = 0;

        // Z[0] is the length of the entire string
        z[0] = n;

        for (int i = 1; i < n; i++) {

            if (i <= right) {
                z[i] = Math.min(right - i + 1, z[i - left]);
            }

            // Extend the matching prefix
            while (i + z[i] < n &&
                   s.charAt(z[i]) == s.charAt(i + z[i])) {
                z[i]++;
            }

            // Update the Z-box
            if (i + z[i] - 1 > right) {
                left = i;
                right = i + z[i] - 1;
            }
        }

        // Sum of similarities
        long result = 0;

        for (int i = 0; i < n; i++) {
            result += z[i];
        }

        return result;
    }

    public static void main(String[] args) throws IOException {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int t = Integer.parseInt(br.readLine().trim());

        while (t-- > 0) {
            String s = br.readLine().trim();

            System.out.println(stringSimilarity(s));
        }
    }
}
