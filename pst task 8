public class Fibonacci {
    public static int get_nth_fibonacci(int n) {
        if (n < 0) {
            throw new IllegalArgumentException("Number must be non-negative.");
        }
        if (n == 0) return 0;
        if (n == 1) return 1;

        int a = 0; 
        int b = 1; 
        int c = 0; 

        for (int i = 2; i <= n; i++) {
            c = a + b;
            a = b;
            b = c;
        }
        return b;
    }

    public static void main(String[] args) {
        int n = 9; 
        System.out.println("The " + n + "th Fibonacci number is: " + get_nth_fibonacci(n));
    }
}
