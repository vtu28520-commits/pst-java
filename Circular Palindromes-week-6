import java.io.*;
import java.util.*;

public class Solution {

    static int[] manacherOdd(char[] s) {
        int n = s.length;
        int[] d1 = new int[n];

        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 1 : Math.min(d1[l + r - i], r - i + 1);

            while (i - k >= 0 && i + k < n &&
                   s[i - k] == s[i + k]) {
                k++;
            }

            d1[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        return d1;
    }

    static int[] manacherEven(char[] s) {
        int n = s.length;
        int[] d2 = new int[n];

        int l = 0, r = -1;

        for (int i = 0; i < n; i++) {
            int k = (i > r) ? 0 :
                    Math.min(d2[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 && i + k < n &&
                   s[i - k - 1] == s[i + k]) {
                k++;
            }

            d2[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        return d2;
    }

    /*
     * Returns the maximum palindrome length for
     * every rotation.
     */
    static int[] solve(String str) {

        int n = str.length();

        // Make S + S
        String doubled = str + str;
        char[] s = doubled.toCharArray();

        int m = s.length;

        // Manacher
        int[] odd = manacherOdd(s);
        int[] even = manacherEven(s);

        /*
         * ans[start] = maximum palindrome completely
         * contained in the window:
         *
         * start ... start+n-1
         */
        int[] ans = new int[n];

        /*
         * ------------------------------------------------
         * Odd length palindromes
         * ------------------------------------------------
         */
        for (int center = 0; center < m; center++) {

            int radius = odd[center];

            /*
             * Maximum palindrome is:
             *
             * center-radius+1 ... center+radius-1
             */
            int L = center - radius + 1;
            int R = center + radius - 1;

            /*
             * A rotation beginning at start has range:
             *
             * start ... start+n-1
             *
             * We need the palindrome to fit inside it.
             */
            int minStart = Math.max(0, R - n + 1);
            int maxStart = L;

            minStart = Math.max(minStart, center - n + 1);
            maxStart = Math.min(maxStart, center);

            /*
             * Only rotations 0 ... n-1 are required.
             */
            minStart = Math.max(minStart, 0);
            maxStart = Math.min(maxStart, n - 1);

            if (minStart <= maxStart) {

                /*
                 * For a fixed center:
                 *
                 * length = 2 * min(
                 *      center-start,
                 *      start+n-1-center
                 * ) + 1
                 *
                 * The function increases and then decreases.
                 *
                 * We update the affected range using a
                 * difference-style technique below.
                 */

                int middle = (2 * center - n + 1) / 2;

                int left = minStart;
                int right = Math.min(maxStart, middle);

                if (left <= right) {
                    /*
                     * length =
                     * 2*(start+n-1-center)+1
                     *
                     * = 2*start + constant
                     *
                     * Since this is increasing with start,
                     * update individual boundary candidates.
                     */
                    for (int start = left; start <= right; start++) {
                        int len = 2 * Math.min(
                                center - start,
                                start + n - 1 - center
                        ) + 1;

                        if (len > ans[start]) {
                            ans[start] = len;
                        }
                    }
                }

                left = Math.max(minStart, middle + 1);
                right = maxStart;

                if (left <= right) {
                    for (int start = left; start <= right; start++) {
                        int len = 2 * Math.min(
                                center - start,
                                start + n - 1 - center
                        ) + 1;

                        if (len > ans[start]) {
                            ans[start] = len;
                        }
                    }
                }
            }
        }

        /*
         * ------------------------------------------------
         * Even length palindromes
         * ------------------------------------------------
         */
        for (int center = 0; center < m; center++) {

            int radius = even[center];

            if (radius == 0) {
                continue;
            }

            int L = center - radius;
            int R = center + radius - 1;

            int minStart = Math.max(0, R - n + 1);
            int maxStart = L;

            minStart = Math.max(minStart, center - n);
            maxStart = Math.min(maxStart, center);

            minStart = Math.max(minStart, 0);
            maxStart = Math.min(maxStart, n - 1);

            if (minStart <= maxStart) {

                int middle = (2 * center - n) / 2;

                int left = minStart;
                int right = Math.min(maxStart, middle);

                if (left <= right) {
                    for (int start = left; start <= right; start++) {

                        int len = 2 * Math.min(
                                center - start,
                                start + n - center
                        );

                        if (len > ans[start]) {
                            ans[start] = len;
                        }
                    }
                }

                left = Math.max(minStart, middle + 1);
                right = maxStart;

                if (left <= right) {
                    for (int start = left; start <= right; start++) {

                        int len = 2 * Math.min(
                                center - start,
                                start + n - center
                        );

                        if (len > ans[start]) {
                            ans[start] = len;
                        }
                    }
                }
            }
        }

        return ans;
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
                new BufferedReader(
                        new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        int[] answer = solve(s);

        StringBuilder out = new StringBuilder();

        for (int i = 0; i < n; i++) {
            out.append(answer[i]);

            if (i < n - 1) {
                out.append('\n');
            }
        }

        System.out.print(out.toString());
    }
}
